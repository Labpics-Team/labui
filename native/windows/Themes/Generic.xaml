<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LabUI.WinUI"
    xmlns:rendering="using:LabUI.WinUI.Rendering">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="ms-appx:///LabUI.WinUI/generated/ThemeResources.g.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style TargetType="local:LabButton">
    <Setter Property="FontFamily" Value="ms-appx:///LabUI.WinUI/Assets/Fonts/Geist-Variable.ttf#Geist" />
    <Setter Property="Foreground" Value="{ThemeResource LabLabelOnAccentBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:LabButton">
          <Grid x:Name="PART_Root" Background="Transparent">
            <rendering:ButtonLayers x:Name="PART_Layers" IsHitTestVisible="False"
                Fill="{ThemeResource LabFillAccentBrush}"
                Light="{ThemeResource LabLightBrush}"
                Dark="{ThemeResource LabDarkBrush}"
                ShadowOpacity="{ThemeResource LabButtonShadowOpacity}" />
            <StackPanel x:Name="PART_Content" Orientation="Horizontal"
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
              <Viewbox x:Name="PART_Leading" Stretch="Uniform" Visibility="Collapsed">
                <IconSourceElement IconSource="{TemplateBinding LeadingIcon}" />
              </Viewbox>
              <StackPanel x:Name="PART_LabelGroup" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="PART_Label"
                    Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                    Foreground="{TemplateBinding Foreground}"
                    FontFamily="{TemplateBinding FontFamily}"
                    VerticalAlignment="Center" TextWrapping="NoWrap" />
                <TextBlock x:Name="PART_Description" Text="{TemplateBinding Description}"
                    Foreground="{ThemeResource LabLabelSecondaryOnAccentBrush}"
                    FontFamily="{TemplateBinding FontFamily}"
                    VerticalAlignment="Center" TextWrapping="NoWrap" Visibility="Collapsed" />
              </StackPanel>
              <Viewbox x:Name="PART_Trailing" Stretch="Uniform" Visibility="Collapsed">
                <IconSourceElement IconSource="{TemplateBinding TrailingIcon}" />
              </Viewbox>
            </StackPanel>
            <Border x:Name="PART_Focus" BorderBrush="{ThemeResource LabFocusBrush}"
                IsHitTestVisible="False" Visibility="Collapsed" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
