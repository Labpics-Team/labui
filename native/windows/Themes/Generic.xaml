<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LabUI.WinUI"
    xmlns:rendering="using:LabUI.WinUI.Rendering">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="ms-appx:///LabUI.WinUI/generated/ThemeResources.g.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style TargetType="local:LabButton">
    <Setter Property="FontFamily" Value="ms-appx:///LabUI.WinUI/Assets/Fonts/Geist-Variable.ttf#Geist" />
    <Setter Property="Foreground" Value="{ThemeResource LabLabelOnAccentBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:LabButton">
          <Grid x:Name="PART_Root" Background="Transparent">
            <rendering:ButtonLayers x:Name="PART_Layers" IsHitTestVisible="False"
                Fill="{ThemeResource LabFillAccentBrush}"
                Light="{ThemeResource LabLightBrush}"
                Dark="{ThemeResource LabDarkBrush}"
                ShadowOpacity="{ThemeResource LabButtonShadowOpacity}" />
            <StackPanel x:Name="PART_Content" Orientation="Horizontal"
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
              <Viewbox x:Name="PART_Leading" Stretch="Uniform" Visibility="Collapsed">
                <IconSourceElement IconSource="{TemplateBinding LeadingIcon}" />
              </Viewbox>
              <StackPanel x:Name="PART_LabelGroup" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="PART_Label"
                    Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                    Foreground="{TemplateBinding Foreground}"
                    FontFamily="{TemplateBinding FontFamily}"
                    VerticalAlignment="Center" TextWrapping="NoWrap" />
                <TextBlock x:Name="PART_Description" Text="{TemplateBinding Description}"
                    Foreground="{ThemeResource LabLabelSecondaryOnAccentBrush}"
                    FontFamily="{TemplateBinding FontFamily}"
                    VerticalAlignment="Center" TextWrapping="NoWrap" Visibility="Collapsed" />
              </StackPanel>
              <Viewbox x:Name="PART_Trailing" Stretch="Uniform" Visibility="Collapsed">
                <IconSourceElement IconSource="{TemplateBinding TrailingIcon}" />
              </Viewbox>
            </StackPanel>
            <Border x:Name="PART_Focus" BorderBrush="{ThemeResource LabFocusBrush}"
                IsHitTestVisible="False" Visibility="Collapsed" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="local:LabSheet">
    <Setter Property="FontFamily" Value="ms-appx:///LabUI.WinUI/Assets/Fonts/Geist-Variable.ttf#Geist" />
    <Setter Property="Foreground" Value="{ThemeResource LabLabelPrimaryBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:LabSheet">
          <Grid>
            <rendering:SheetLayers x:Name="PART_Layers" IsHitTestVisible="False"
                Tint="{ThemeResource LabSheetTintBrush}" Blend="{ThemeResource LabSheetBlendBrush}"
                Ghost="{ThemeResource LabSheetGhostBrush}" Border="{ThemeResource LabSheetBorderBrush}"
                Noise="{ThemeResource LabSheetNoiseBrush}" ShadowInk="{ThemeResource LabDarkBrush}"
                Solid="{ThemeResource LabSheetSolidBrush}" />
            <Grid x:Name="PART_Body" AutomationProperties.AutomationId="SheetBody">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid x:Name="PART_DragArea">
                <Border x:Name="PART_Indicator" HorizontalAlignment="Center" VerticalAlignment="Top"
                    AutomationProperties.AutomationId="SheetIndicator"
                    Background="{ThemeResource LabSheetHandleBrush}" IsHitTestVisible="False" />
              </Grid>
              <ContentPresenter Grid.Row="1" Content="{TemplateBinding Content}"
                  ContentTemplate="{TemplateBinding ContentTemplate}"
                  ContentTransitions="{TemplateBinding ContentTransitions}"
                  Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}"
                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Grid>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
