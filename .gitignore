# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Svelte tooling cache (svelte-package intermediate)
.svelte-kit/

# tsup transient bundled-config artifacts
tsup.config.bundled_*.mjs

# Playwright
test-results/
playwright-report/
blob-report/
.playwright/
playwright/.cache/
.playwright-mcp/

# Ad-hoc demo screenshots (owner-review artifacts, regenerated on demand)
screenshots/

# Env / secrets — never commit
.env
.env.*
!.env.example
*.local

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Agent harness scratch (git worktrees, transient notes) — never committed
.claude/
*.log
npm-debug.log*
pnpm-debug.log*

# Coverage
coverage/
.nyc_output/

# design-phase audit artifacts (specs/screenshots) — не в продуктовом репо
.design/

# FX-render гейт: PNG-скриншоты и measurements пишутся сюда на лету (локально
# `pnpm --filter @labui/colors fx:render` и в CI-джобе e2e) как эфемерное
# доказательство для владельца. Это бинарь/вывод, а не исходник — в git он
# раздувал бы пакет colors, поэтому каталог игнорируется. В CI сам PNG отдаётся
# как artifact workflow (actions/upload-artifact), провенанс замеров — на лету.
packages/colors/artifacts/
