diff --git a/lib/limits.js b/lib/limits.js
new file mode 100644
index 0000000..9ce79b2
--- /dev/null
+++ b/lib/limits.js
@@ -0,0 +1,27 @@
+'use strict';
+
+const MAX_DEPTH = 100;
+const MAX_NODES = 65536;
+
+// Parent links belong to the parser; only the child traversal is recursive.
+const validate = ast => {
+  const stack = [{ node: ast, depth: 0, leave: false }];
+  const ancestors = new Set();
+  let visited = 0;
+  while (stack.length > 0) {
+    const { node, depth, leave } = stack.pop();
+    if (!node || typeof node !== 'object') continue;
+    if (leave) { ancestors.delete(node); continue; }
+    if (depth > MAX_DEPTH && Array.isArray(node.nodes)) throw new RangeError('Brace AST nesting exceeds 100 levels');
+    if (ancestors.has(node)) throw new RangeError('Brace AST contains cyclic nodes');
+    if (++visited > MAX_NODES) throw new RangeError('Brace AST exceeds node budget');
+    ancestors.add(node);
+    stack.push({ node, depth, leave: true });
+    if (Array.isArray(node.nodes)) {
+      if (node.nodes.length > MAX_NODES) throw new RangeError('Brace AST exceeds node budget');
+      for (let i = node.nodes.length - 1; i >= 0; i--) stack.push({ node: node.nodes[i], depth: depth + 1, leave: false });
+    }
+  }
+};
+
+module.exports = Object.freeze({ MAX_DEPTH, validate });
