<Page
    x:Class="LabUI.Buttons.SheetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lab="using:LabUI.WinUI"
    Background="{ThemeResource LabPageBrush}">
  <lab:LabSheetHost Background="{ThemeResource LabPageBrush}">
    <lab:LabSheetHost.Content>
      <Image x:Name="Backdrop" AutomationProperties.AutomationId="SheetViewport"
          Source="{x:Bind BackdropSource}" Stretch="UniformToFill" />
    </lab:LabSheetHost.Content>
    <lab:LabSheetHost.Sheet>
      <lab:LabSheet x:Name="Sheet" AutomationProperties.Name="Нижняя панель"
          AutomationProperties.AutomationId="Sheet" />
    </lab:LabSheetHost.Sheet>
  </lab:LabSheetHost>
</Page>
