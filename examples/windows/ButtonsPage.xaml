<Page x:Class="LabUI.Buttons.ButtonsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lab="using:LabUI.WinUI"
    AutomationProperties.AutomationId="LabButtonsPage"
    RequestedTheme="Light"
    Background="{ThemeResource LabPageBrush}"
    Foreground="{ThemeResource LabLabelPrimaryBrush}"
    FontFamily="ms-appx:///LabUI.WinUI/Assets/Fonts/Geist-Variable.ttf#Geist">
  <ScrollViewer HorizontalScrollBarVisibility="Auto">
    <StackPanel Spacing="32" Padding="40">
      <StackPanel Spacing="8">
        <TextBlock Text="LabUI" FontSize="32" FontWeight="SemiBold" />
        <TextBlock Text="Нативные кнопки" FontSize="20" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
        <lab:LabButton AutomationProperties.AutomationId="LabButtonSmall" Content="Button" Size="Small" Click="Activate" VerticalAlignment="Center" />
        <lab:LabButton AutomationProperties.AutomationId="LabButtonMedium" Content="Button" Size="Medium" Click="Activate" VerticalAlignment="Center" />
        <lab:LabButton AutomationProperties.AutomationId="LabButtonLarge" Content="Button" Size="Large" Click="Activate" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="20">
        <lab:LabButton AutomationProperties.AutomationId="LabButtonSmallDescription" Content="Button" Description="Description" Size="Small" Click="Activate" VerticalAlignment="Center" />
        <lab:LabButton AutomationProperties.AutomationId="LabButtonDescription" Content="Добавить" Description="файл" Click="Activate">
          <lab:LabButton.LeadingIcon>
            <PathIconSource Data="M 11,4 H 13 V 11 H 20 V 13 H 13 V 20 H 11 V 13 H 4 V 11 H 11 Z" />
          </lab:LabButton.LeadingIcon>
        </lab:LabButton>
        <lab:LabButton AutomationProperties.AutomationId="LabButtonTrailingIcon" Content="Открыть" Click="Activate">
          <lab:LabButton.TrailingIcon>
            <PathIconSource Data="M 9,5 L 16,12 L 9,19 L 8,18 L 14,12 L 8,6 Z" />
          </lab:LabButton.TrailingIcon>
        </lab:LabButton>
      </StackPanel>
      <lab:LabButton x:Name="Unavailable" AutomationProperties.AutomationId="LabButtonDisabled" Content="Недоступно" IsEnabled="False" HorizontalAlignment="Left" Click="Activate" />
      <TextBlock x:Name="Result" AutomationProperties.AutomationId="LabActionResult" Text="Готово к работе" AutomationProperties.LiveSetting="Polite" />
      <StackPanel Orientation="Horizontal" Spacing="20">
        <lab:LabButton AutomationProperties.AutomationId="LabThemeLight" Content="Светлая тема" Size="Small" Click="LightTheme" />
        <lab:LabButton AutomationProperties.AutomationId="LabThemeDark" Content="Тёмная тема" Size="Small" Click="DarkTheme" />
        <lab:LabButton AutomationProperties.AutomationId="LabToggleEnabled" Content="Включить кнопку" Size="Small" Click="ToggleEnabled" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
