{
  "name": "@labpics/ui-react",
  "version": "0.0.0",
  "private": true,
  "description": "React-компоненты Lab UI: DOM-рендеринг с общими типами и поведением из @labpics/ui-core.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "sideEffects": ["**/*.css"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@labpics/ui-core": "workspace:*",
    "@labpics/ui-shadow": "workspace:*",
    "@zag-js/accordion": "1.41.2",
    "@zag-js/checkbox": "1.41.2",
    "@zag-js/combobox": "1.41.2",
    "@zag-js/dialog": "1.41.2",
    "@zag-js/menu": "1.41.2",
    "@zag-js/number-input": "1.41.2",
    "@zag-js/pin-input": "1.41.2",
    "@zag-js/popover": "1.41.2",
    "@zag-js/pagination": "1.41.2",
    "@zag-js/progress": "1.41.2",
    "@zag-js/radio-group": "1.41.2",
    "@zag-js/react": "1.41.2",
    "@zag-js/select": "1.41.2",
    "@zag-js/slider": "1.41.2",
    "@zag-js/switch": "1.41.2",
    "@zag-js/tabs": "1.41.2",
    "@zag-js/tags-input": "1.41.2",
    "@zag-js/toggle": "1.41.2",
    "@zag-js/tooltip": "1.41.2"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsup": "8.3.6",
    "typescript": "5.7.3"
  }
}
