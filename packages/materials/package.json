{
  "name": "@labpics/ui-materials",
  "version": "0.0.0",
  "private": true,
  "description": "Материалы Lab UI: Solid, Glass, Acrylic, краевой progressive blur и runtime поверх семантических --lab-* ролей.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./css": {
      "import": {
        "types": "./dist/css.d.ts",
        "default": "./dist/css.js"
      },
      "require": {
        "types": "./dist/css.d.cts",
        "default": "./dist/css.cjs"
      }
    },
    "./material.css": "./dist/material.css",
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "sideEffects": ["./dist/material.css"],
  "scripts": {
    "build": "tsup && tsx scripts/copy-artifacts.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run && pnpm test:package",
    "test:package": "pnpm build && tsx scripts/check-css-package.ts",
    "test:watch": "vitest",
    "check-generated": "tsx scripts/build-acrylic-noise.ts && git diff --exit-code src/materials/acrylic.css",
    "bench": "tsx bench/field-build.bench.ts"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "esbuild": "0.28.2",
    "tsup": "8.3.6",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "3.2.6"
  }
}
