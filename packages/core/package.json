{
  "name": "@labpics/ui-core",
  "version": "0.0.0",
  "private": true,
  "description": "Cross-stack component core. Form depends on the base decision in cross-stack-core.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./glass.css": "./dist/glass.css",
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "sideEffects": ["./dist/glass.css"],
  "scripts": {
    "build": "tsup && tsx scripts/copy-artifacts.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "8.3.6",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
