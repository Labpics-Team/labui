{
  "name": "@labpics/ui-core",
  "version": "0.0.0",
  "private": true,
  "description": "Компоненты Lab UI на Lit, общие типы и поведение, темы, материалы и серверный рендеринг для веб-привязок.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ssr": {
      "types": "./dist/ssr/index.d.ts",
      "import": "./dist/ssr/index.js",
      "require": "./dist/ssr/index.cjs"
    },
    "./proof": {
      "types": "./dist/proof/lab-proof.d.ts",
      "import": "./dist/proof/lab-proof.js",
      "require": "./dist/proof/lab-proof.cjs"
    },
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js",
      "require": "./dist/components/*/index.cjs"
    },
    "./theme.css": "./dist/theme.css",
    "./selection.css": "./dist/selection.css",
    "./shadow.css": "./dist/shadow.css",
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "sideEffects": [
    "./dist/theme.css",
    "./dist/selection.css",
    "./dist/shadow.css",
    "./dist/proof/lab-proof.js",
    "./dist/proof/lab-proof.cjs",
    "./dist/components/**"
  ],
  "scripts": {
    "build": "tsup && tsx scripts/copy-artifacts.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@labpics/ui-shadow": "workspace:*",
    "@zag-js/accordion": "1.41.2",
    "@zag-js/checkbox": "1.41.2",
    "@zag-js/combobox": "1.41.2",
    "@zag-js/core": "1.41.2",
    "@zag-js/dialog": "1.41.2",
    "@zag-js/menu": "1.41.2",
    "@zag-js/number-input": "1.41.2",
    "@zag-js/pin-input": "1.41.2",
    "@zag-js/popover": "1.41.2",
    "@zag-js/pagination": "1.41.2",
    "@zag-js/progress": "1.41.2",
    "@zag-js/radio-group": "1.41.2",
    "@zag-js/select": "1.41.2",
    "@zag-js/slider": "1.41.2",
    "@zag-js/switch": "1.41.2",
    "@zag-js/tabs": "1.41.2",
    "@zag-js/tags-input": "1.41.2",
    "@zag-js/toggle": "1.41.2",
    "@zag-js/tooltip": "1.41.2",
    "@zag-js/types": "1.41.2",
    "@zag-js/vanilla": "1.41.2",
    "lit": "3.3.3"
  },
  "peerDependencies": {
    "@lit-labs/ssr": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "@lit-labs/ssr": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lit-labs/ssr": "4.1.0",
    "tsup": "8.3.6",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "3.2.6"
  }
}
