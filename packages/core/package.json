{
  "name": "@labpics/ui-core",
  "version": "0.0.0",
  "private": true,
  "description": "Компоненты Lab UI на Lit, общие типы и поведение, темы, материалы и серверный рендеринг для веб-привязок.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ssr": {
      "types": "./dist/ssr/index.d.ts",
      "import": "./dist/ssr/index.js",
      "require": "./dist/ssr/index.cjs"
    },
    "./proof": {
      "types": "./dist/proof/lab-proof.d.ts",
      "import": "./dist/proof/lab-proof.js",
      "require": "./dist/proof/lab-proof.cjs"
    },
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js",
      "require": "./dist/components/*/index.cjs"
    },
    "./theme.css": "./dist/theme.css",
    "./selection.css": "./dist/selection.css",
    "./shadow.css": "./dist/shadow.css",
    "./tokens.css": "./dist/tokens.css",
    "./sheet.css": "./dist/sheet.css",
    "./input.css": "./dist/input.css",
    "./snackbar.css": "./dist/snackbar.css",
    "./card.css": "./dist/card.css",
    "./switch.css": "./dist/switch.css",
    "./switch/runtime": {
      "types": "./dist/components/switch/runtime.d.ts",
      "import": "./dist/components/switch/runtime.js",
      "require": "./dist/components/switch/runtime.cjs"
    },
    "./package.json": "./package.json",
    "./dialog/shared": {
      "types": "./dist/components/dialog/shared.d.ts",
      "import": "./dist/components/dialog/shared.js",
      "require": "./dist/components/dialog/shared.cjs"
    },
    "./sheet/positions": {
      "types": "./dist/components/sheet/positions.d.ts",
      "import": "./dist/components/sheet/positions.js",
      "require": "./dist/components/sheet/positions.cjs"
    },
    "./motion/sheet": {
      "types": "./dist/motion/sheet.d.ts",
      "import": "./dist/motion/sheet.js",
      "require": "./dist/motion/sheet.cjs"
    },
    "./snackbar/runtime": {
      "types": "./dist/components/snackbar/runtime.d.ts",
      "import": "./dist/components/snackbar/runtime.js",
      "require": "./dist/components/snackbar/runtime.cjs"
    },
    "./card/runtime": {
      "types": "./dist/components/card/runtime.d.ts",
      "import": "./dist/components/card/runtime.js",
      "require": "./dist/components/card/runtime.cjs"
    },
    "./sheet/measure": {
      "types": "./dist/components/sheet/measure.d.ts",
      "import": "./dist/components/sheet/measure.js",
      "require": "./dist/components/sheet/measure.cjs"
    },
    "./badge.css": "./dist/badge.css",
    "./badge/contract": {
      "types": "./dist/components/badge/contract.d.ts",
      "import": "./dist/components/badge/contract.js",
      "require": "./dist/components/badge/contract.cjs"
    },
    "./selection/runtime": {
      "types": "./dist/components/selection/runtime.d.ts",
      "import": "./dist/components/selection/runtime.js",
      "require": "./dist/components/selection/runtime.cjs"
    },
    "./selection-controls.css": "./dist/selection-controls.css",
    "./kbd.css": "./dist/kbd.css",
    "./kbd/contract": {
      "types": "./dist/components/kbd/contract.d.ts",
      "import": "./dist/components/kbd/contract.js",
      "require": "./dist/components/kbd/contract.cjs"
    },
    "./progress/runtime": {
      "types": "./dist/components/progress/runtime.d.ts",
      "import": "./dist/components/progress/runtime.js",
      "require": "./dist/components/progress/runtime.cjs"
    },
    "./progress.css": "./dist/progress.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./src/components/*/index.ts",
    "./dist/theme.css",
    "./dist/selection.css",
    "./dist/shadow.css",
    "./dist/tokens.css",
    "./dist/sheet.css",
    "./dist/input.css",
    "./dist/snackbar.css",
    "./dist/card.css",
    "./dist/switch.css",
    "./dist/proof/lab-proof.js",
    "./dist/proof/lab-proof.cjs",
    "./dist/components/**",
    "./dist/chunk-*.js",
    "./dist/chunk-*.cjs",
    "./dist/badge.css",
    "./dist/selection-controls.css",
    "./dist/kbd.css",
    "./dist/progress.css"
  ],
  "scripts": {
    "build": "tsup && tsx scripts/copy-artifacts.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@labpics/motion": "0.5.0",
    "@labpics/ui-materials": "workspace:*",
    "@labpics/ui-shadow": "workspace:*",
    "@labpics/ui-tokens": "workspace:*",
    "@zag-js/accordion": "1.41.2",
    "@zag-js/combobox": "1.41.2",
    "@zag-js/core": "1.41.2",
    "@zag-js/dialog": "1.41.2",
    "@zag-js/dom-query": "1.41.2",
    "@zag-js/menu": "1.41.2",
    "@zag-js/number-input": "1.41.2",
    "@zag-js/pagination": "1.41.2",
    "@zag-js/pin-input": "1.41.2",
    "@zag-js/popover": "1.41.2",
    "@zag-js/select": "1.41.2",
    "@zag-js/slider": "1.41.2",
    "@zag-js/switch": "1.41.2",
    "@zag-js/tabs": "1.41.2",
    "@zag-js/tags-input": "1.41.2",
    "@zag-js/toggle": "1.41.2",
    "@zag-js/tooltip": "1.41.2",
    "@zag-js/types": "1.41.2",
    "@zag-js/vanilla": "1.41.2",
    "lit": "3.3.3"
  },
  "peerDependencies": {
    "@lit-labs/ssr": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "@lit-labs/ssr": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lit-labs/ssr": "4.1.0",
    "tsup": "8.3.6",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "3.2.6"
  }
}
