{
  "name": "@labpics/ui-core",
  "version": "0.0.0",
  "private": true,
  "description": "Cross-stack component core (A-prime): Lit base element + Zag behaviors seam, theme/material contract, token-consumption conventions, and the Lit SSR shim. Shared by the Lit renderer (4 stacks) and the native React renderer.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./shared": {
      "import": {
        "types": "./dist/shared.d.ts",
        "default": "./dist/shared.js"
      },
      "require": {
        "types": "./dist/shared.d.cts",
        "default": "./dist/shared.cjs"
      }
    },
    "./ssr": {
      "import": {
        "types": "./dist/ssr/index.d.ts",
        "default": "./dist/ssr/index.js"
      },
      "require": {
        "types": "./dist/ssr/index.d.cts",
        "default": "./dist/ssr/index.cjs"
      }
    },
    "./hydrate": {
      "import": {
        "types": "./dist/hydrate/index.d.ts",
        "default": "./dist/hydrate/index.js"
      },
      "require": {
        "types": "./types/hydrate.d.cts",
        "default": "./dist/hydrate/index.cjs"
      }
    },
    "./proof": {
      "import": {
        "types": "./dist/proof/lab-proof.d.ts",
        "default": "./dist/proof/lab-proof.js"
      },
      "require": {
        "types": "./dist/proof/lab-proof.d.cts",
        "default": "./dist/proof/lab-proof.cjs"
      }
    },
    "./*": {
      "import": {
        "types": "./dist/components/*/index.d.ts",
        "default": "./dist/components/*/index.js"
      },
      "require": {
        "types": "./dist/components/*/index.d.cts",
        "default": "./dist/components/*/index.cjs"
      }
    },
    "./theme.css": "./dist/theme.css",
    "./selection.css": "./dist/selection.css",
    "./shadow.css": "./dist/shadow.css",
    "./package.json": "./package.json"
  },
  "files": ["dist", "types"],
  "sideEffects": [
    "./src/components/*/index.ts",
    "./dist/theme.css",
    "./dist/selection.css",
    "./dist/shadow.css",
    "./dist/proof/lab-proof.js",
    "./dist/proof/lab-proof.cjs",
    "./dist/components/**"
  ],
  "scripts": {
    "build": "tsup && tsx scripts/copy-artifacts.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@labpics/ui-shadow": "workspace:*",
    "@zag-js/accordion": "1.41.2",
    "@zag-js/checkbox": "1.41.2",
    "@zag-js/combobox": "1.41.2",
    "@zag-js/core": "1.41.2",
    "@zag-js/dialog": "1.41.2",
    "@zag-js/menu": "1.41.2",
    "@zag-js/number-input": "1.41.2",
    "@zag-js/pin-input": "1.41.2",
    "@zag-js/popover": "1.41.2",
    "@zag-js/pagination": "1.41.2",
    "@zag-js/progress": "1.41.2",
    "@zag-js/radio-group": "1.41.2",
    "@zag-js/select": "1.41.2",
    "@zag-js/slider": "1.41.2",
    "@zag-js/switch": "1.41.2",
    "@zag-js/tabs": "1.41.2",
    "@zag-js/tags-input": "1.41.2",
    "@zag-js/toggle": "1.41.2",
    "@zag-js/tooltip": "1.41.2",
    "@zag-js/types": "1.41.2",
    "@zag-js/vanilla": "1.41.2",
    "lit": "3.3.3",
    "magic-string": "0.30.21"
  },
  "peerDependencies": {
    "@lit-labs/ssr": "^4.1.0",
    "@lit-labs/ssr-client": "^1.1.8",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "@lit-labs/ssr": {
      "optional": true
    },
    "@lit-labs/ssr-client": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lit-labs/ssr": "4.1.0",
    "@lit-labs/ssr-client": "1.1.8",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "tsup": "8.3.6",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "3.2.6",
    "vite": "6.4.4"
  }
}
