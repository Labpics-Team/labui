{
  "name": "@labpics/ui-vue",
  "version": "0.0.0",
  "private": true,
  "description": "Vue adapter for LabUI (ADR-0001, A-prime): thin Vue wrappers that mount the shared Lit Web Components (<lab-button>, …) from @labpics/ui-core and forward props/events/slots. Vue consumes the custom elements — it does not re-implement them. Axis types come from @labpics/ui-core.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ssr": {
      "types": "./dist/ssr.d.ts",
      "import": "./dist/ssr.js",
      "require": "./dist/ssr.cjs"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "sideEffects": ["**/*.css"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@labpics/ui-core": "workspace:*"
  },
  "peerDependencies": {
    "@lit-labs/ssr": "^4.1.0",
    "vue": ">=3.4"
  },
  "peerDependenciesMeta": {
    "@lit-labs/ssr": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lit-labs/ssr": "4.1.0",
    "happy-dom": "20.0.0",
    "tsup": "8.3.6",
    "typescript": "5.7.3",
    "vitest": "3.2.6",
    "vue": "3.5.13"
  }
}
