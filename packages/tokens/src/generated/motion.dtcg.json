    "entrance": {
      "$type": "transition",
      "$value": {
        "duration": "{motion.duration.base}",
        "delay": {
          "value": 0,
          "unit": "ms"
        },
        "timingFunction": "{motion.easing.decelerate}"
      },
      "$description": "element appears — decelerate, settles into place",
      "$extensions": {
        "com.labpics.motion": {
          "provenance": {
            "class": "e",
            "source": "LabUI: появление замедляется к месту покоя; сохранённый контракт роли."
          },
          "reducedMotion": {
            "duration": "{motion.duration.fast}",
            "timingFunction": [
              0,
              0,
              1,
              1
            ]
          }
        }
      }
    },
    "exit": {
      "$type": "transition",
      "$value": {
        "duration": "{motion.duration.fast}",
        "delay": {
          "value": 0,
          "unit": "ms"
        },
        "timingFunction": "{motion.easing.accelerate}"
      },
      "$description": "element leaves — accelerate, quicker than entrance",
      "$extensions": {
        "com.labpics.motion": {
          "provenance": {
            "class": "e",
            "source": "LabUI: исчезновение быстрее появления, чтобы завершённое действие освобождало место."
          },
          "reducedMotion": {
            "duration": "{motion.duration.fast}",
            "timingFunction": [
              0,
              0,
              1,
              1
            ]
          }
        }
      }
    },
    "transition": {
      "$type": "transition",
      "$value": {
        "duration": "{motion.duration.fast}",
        "delay": {
          "value": 0,
          "unit": "ms"
        },
        "timingFunction": "{motion.easing.standard}"
      },
      "$description": "in-place state change / move — standard easing",
      "$extensions": {
        "com.labpics.motion": {
          "provenance": {
            "class": "e",
            "source": "LabUI: краткая обратная связь состояния. Сохранённая базовая скорость 100ms; runtime Switch использует её как масштаб времени собственной пружины toggle."
          },
          "reducedMotion": {
            "duration": "{motion.duration.instant}",
            "timingFunction": [
              0,
              0,
              1,
              1
            ]
          }
        }
      }
    },
