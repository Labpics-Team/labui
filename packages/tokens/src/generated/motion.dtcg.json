      "$type": "transition",
      "$value": {
        "duration": "{motion.duration.slow}",
        "delay": {
          "value": 0,
          "unit": "ms"
        },
        "timingFunction": "{motion.easing.emphasized}"
      },
      "$description": "attention moment — the restrained overshoot lives here",
      "$extensions": {
        "com.labpics.motion": {
          "provenance": {
            "class": "e",
            "source": "LabUI: сохранённая отдельная роль привлечения внимания с выраженным движением."
          },
          "reducedMotion": {
            "duration": "{motion.duration.instant}",
            "timingFunction": [
              0,
              0,
              1,
              1
            ]
          },
          "spring": "{motion.spring.expressive}"
        }
      }
