{
  "name": "@labpics/ui-tokens",
  "version": "0.0.0",
  "private": true,
  "description": "LabUI dimension, typography and z-index tokens вЂ” generator and generated output.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens.dtcg.json": "./dist/tokens.dtcg.json",
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "sideEffects": ["./dist/tokens.css"],
  "scripts": {
    "generate": "tsx scripts/build-tokens.ts",
    "check-generated": "tsx scripts/build-tokens.ts && git diff --exit-code src/generated/tokens.css src/generated/tokens.dtcg.json src/generated/tokens.ts",
    "build": "pnpm run generate && tsup && tsx scripts/copy-artifacts.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "tsup": "8.3.6",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "3.2.6"
  }
}
