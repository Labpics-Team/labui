{
  "name": "@labpics/ui-tokens",
  "version": "0.0.0",
  "private": true,
  "description": "Lab UI dimension, typography, z-index and semantic motion tokens.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens.dtcg.json": "./dist/tokens.dtcg.json",
    "./motion.css": "./dist/motion.css",
    "./motion": {
      "import": {
        "types": "./dist/generated/motion.d.ts",
        "default": "./dist/generated/motion.js"
      },
      "require": {
        "types": "./dist/generated/motion.d.cts",
        "default": "./dist/generated/motion.cjs"
      }
    },
    "./motion.dtcg.json": "./dist/motion.dtcg.json",
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "sideEffects": ["./dist/tokens.css", "./dist/motion.css"],
  "scripts": {
    "generate": "tsx scripts/build-tokens.ts && tsx scripts/build-motion.ts",
    "check-generated": "tsx scripts/build-tokens.ts && tsx scripts/build-motion.ts && git diff --exit-code src/generated/tokens.css src/generated/tokens.dtcg.json src/generated/tokens.ts src/generated/motion.css src/generated/motion.dtcg.json src/generated/motion.ts",
    "build": "pnpm run generate && tsup && tsx scripts/copy-artifacts.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@labpics/motion": "0.5.0",
    "@types/node": "22.10.5",
    "tsup": "8.3.6",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "3.2.6"
  }
}
