---
/**
 * СГЕНЕРИРОВАНО @labpics/adapter-codegen — НЕ РЕДАКТИРОВАТЬ вручную.
 * Источник истины: packages/adapter-codegen/manifest.generated.json,
 * выведенный из исходников @labpics/ui-core (тэги lab-*, @property, события).
 * Регенерация: pnpm --filter @labpics/adapter-codegen generate.
 * Правки вносить в генератор/манифест, иначе перегенерация их сотрёт.
 */
import { renderCard } from '@labpics/ui-astro/ssr';

const dsd = renderCard(Astro.props, {
  default: Astro.slots.has('default') ? await Astro.slots.render('default') : undefined,
  footer: Astro.slots.has('footer') ? await Astro.slots.render('footer') : undefined,
  header: Astro.slots.has('header') ? await Astro.slots.render('header') : undefined,
  media: Astro.slots.has('media') ? await Astro.slots.render('media') : undefined,
});
---
<Fragment set:html={dsd} />
<script>
  // Порядок важен: hydrate-support ДО lit; затем регистрация элемента — LitElement
  // сам гидрируется из declarative shadow DOM.
  import '@lit-labs/ssr-client/lit-element-hydrate-support.js';
  import '@labpics/ui-core/card';
</script>
