---
/**
 * СГЕНЕРИРОВАНО @labpics/adapter-codegen — НЕ РЕДАКТИРОВАТЬ вручную.
 * Источник истины: packages/adapter-codegen/manifest.generated.json,
 * выведенный из исходников @labpics/ui-core (тэги lab-*, @property, события).
 * Регенерация: pnpm --filter @labpics/adapter-codegen generate.
 * Правки вносить в генератор/манифест, иначе перегенерация их сотрёт.
 */
import { renderBadge } from '@labpics/ui-astro/ssr';

if (!import.meta.env.LABUI_HYDRATE) {
  throw new Error('LabUI SSR: добавьте hydrate() из @labpics/ui-astro/hydrate в integrations в astro.config.');
}

const dsd = renderBadge(Astro.props, {
  default: Astro.slots.has('default') ? await Astro.slots.render('default') : undefined,
  dot: Astro.slots.has('dot') ? await Astro.slots.render('dot') : undefined,
  leading: Astro.slots.has('leading') ? await Astro.slots.render('leading') : undefined,
  trailing: Astro.slots.has('trailing') ? await Astro.slots.render('trailing') : undefined,
});
---
<Fragment set:html={dsd} />
<script>
  import '@labpics/ui-core/badge';
</script>
