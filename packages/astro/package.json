{
  "name": "@labpics/ui-astro",
  "version": "0.0.0",
  "private": true,
  "description": "Astro adapter for LabUI (ADR-0001, A-prime): thin .astro wrappers that SSR the shared Lit Web Components (<lab-button>, …) to declarative shadow DOM via @labpics/ui-core and hydrate them on the client. Astro consumes the custom elements — it does not re-implement them. @astrojs/lit is deprecated on Astro 5, so this uses the manual Lit SSR recipe.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/ssr.js",
  "module": "./dist/ssr.js",
  "types": "./dist/ssr.d.ts",
  "exports": {
    ".": {
      "types": "./dist/ssr.d.ts",
      "import": "./dist/ssr.js",
      "require": "./dist/ssr.cjs"
    },
    "./ssr": {
      "types": "./dist/ssr.d.ts",
      "import": "./dist/ssr.js",
      "require": "./dist/ssr.cjs"
    },
    "./*.astro": "./src/astro/*.astro",
    "./package.json": "./package.json"
  },
  "files": ["dist", "src/astro"],
  "sideEffects": ["**/*.astro", "**/*.css"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@labpics/ui-core": "workspace:*",
    "@lit-labs/ssr-client": "^1.1.8"
  },
  "peerDependencies": {
    "@lit-labs/ssr": "^4.1.0",
    "astro": ">=4"
  },
  "peerDependenciesMeta": {
    "@lit-labs/ssr": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lit-labs/ssr": "4.1.0",
    "@types/node": "22.15.3",
    "astro": "7.2.8",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "tsup": "8.3.6",
    "typescript": "5.7.3",
    "vitest": "3.2.6"
  }
}
