{
  "name": "@labpics/ui-shadow",
  "version": "0.0.0",
  "private": true,
  "description": "LabUI shadow stack вЂ” five elevation sizes (XS/S/M/L/XL), four fixed-alpha plies each, verbatim from the owner's Figma styles; neutral anchor, opt-in weak tint, vertical light by default, role aliases.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./shadow.css": "./dist/shadow.css",
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "sideEffects": ["./dist/shadow.css"],
  "scripts": {
    "generate": "tsx scripts/build-shadow.ts",
    "check-generated": "tsx scripts/build-shadow.ts && git diff --exit-code src/generated/shadow.css",
    "build": "pnpm run generate && tsup && tsx scripts/copy-artifacts.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "tsup": "8.3.6",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "3.2.6"
  }
}
