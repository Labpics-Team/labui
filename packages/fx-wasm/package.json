{
  "name": "@labpics/fx-wasm",
  "version": "0.0.0",
  "private": true,
  "description": "WASM bindings for LabUI effects engine",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "8.3.6",
    "typescript": "5.7.3"
  }
}
