{
  "name": "@labui/colors",
  "version": "0.0.0",
  "private": true,
  "description": "Lab UI color boundary: Figma-derived reference, generated semantic CSS contract, and conformance checks over @labpics/colors.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./contract.css": "./contract.css",
    "./contract.min.css": "./contract.min.css",
    "./roles.json": "./roles.json",
    "./labui.config.json": "./labui.config.json",
    "./prepare-config.mjs": "./prepare-config.mjs",
    "./runtime": {
      "types": "./browser.d.mts",
      "import": "./browser.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "contract.css",
    "contract.min.css",
    "roles.json",
    "labui.config.json",
    "prepare-config.mjs",
    "prepare-config.d.mts",
    "program.mjs",
    "runtime.mjs",
    "runtime-inputs.mjs",
    "runtime-snapshot.mjs",
    "browser.mjs",
    "browser-authority.mjs",
    "browser-host.mjs",
    "browser-inputs.mjs",
    "browser.d.mts"
  ],
  "scripts": {
    "generate": "node generate-contract.mjs",
    "build": "node generate-contract.mjs && node ../../scripts/minify-contract.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "fx:render": "node test/fx-render/render-fx.mjs",
    "measure:overlays": "node test/state-overlay-economy.mjs"
  },
  "dependencies": {
    "@labpics/colors": "0.6.2"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "typescript": "5.7.3",
    "vitest": "3.2.6"
  }
}
