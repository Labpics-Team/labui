{
  "name": "@labui/colors",
  "version": "0.0.0",
  "private": true,
  "description": "Lab UI color boundary: Figma-derived reference, generated semantic CSS contract, and conformance checks over @labpics/colors.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./contract.css": "./contract.css",
    "./contract.min.css": "./contract.min.css",
    "./roles.json": "./roles.json",
    "./labui.config.json": "./labui.config.json",
    "./program-source": {
      "types": "./program-source.d.mts",
      "import": "./program-source.mjs"
    },
    "./runtime": {
      "types": "./runtime.d.mts",
      "import": "./runtime.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "contract.css",
    "contract.min.css",
    "roles.json",
    "labui.config.json",
    "runtime.mjs",
    "runtime.d.mts",
    "program.mjs",
    "program-source.mjs",
    "program-source.d.mts",
    "profile.mjs"
  ],
  "scripts": {
    "generate": "node generate-contract.mjs",
    "build": "node generate-contract.mjs && node ../../scripts/minify-contract.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "fx:render": "node test/fx-render/render-fx.mjs"
  },
  "dependencies": {
    "@labpics/colors": "1.0.3"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "typescript": "5.7.3",
    "vitest": "4.1.11"
  }
}
