{
  "name": "@labpics/ui-fx",
  "version": "0.0.0",
  "private": true,
  "description": "LabUI effects engine — WebGPU/WebGL2 glass refraction, progressive blur, penumbra shadows.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@labpics/fx-wasm": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@webgpu/types": "0.1.54",
    "tsup": "8.3.6",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
