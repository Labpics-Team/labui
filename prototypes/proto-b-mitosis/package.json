{
  "name": "proto-b-mitosis",
  "version": "0.0.0",
  "private": true,
  "description": "Throwaway prototype B: LabUI Button written once in Mitosis, compiled to React/Vue/Solid/Svelte. Measures the cross-stack write-once path. NOT part of the @labpics workspace — self-contained, deletable.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "compile": "mitosis build --config ./mitosis.config.cjs && tsx ./scripts/patch-output.ts",
    "measure": "tsx ./scripts/measure.ts",
    "typecheck:react": "tsc --noEmit -p ./output/tsconfig.react.json",
    "build:next": "cd fixtures/next && next build",
    "build:astro": "cd fixtures/astro && astro build",
    "test:e2e": "playwright test -c ./playwright.config.ts"
  },
  "devDependencies": {
    "@astrojs/node": "9.0.0",
    "@astrojs/react": "4.2.0",
    "@builder.io/mitosis": "0.13.2",
    "@builder.io/mitosis-cli": "0.13.2",
    "@playwright/test": "1.49.1",
    "@types/node": "22.10.5",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "astro": "5.1.1",
    "esbuild": "0.24.2",
    "next": "15.1.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "svelte": "5.16.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
