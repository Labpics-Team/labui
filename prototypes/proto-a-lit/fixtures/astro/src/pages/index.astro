---
// Registers the custom element for Astro's Lit SSR renderer.
import '@labpics/proto-a-lit';
import '@labpics/colors/contract.css';
import '@labpics/ui-tokens/tokens.css';
import '../../../themes.css';
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>proto-a-lit · Astro SSR</title>
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        background: var(--lab-surface-base);
        color: var(--lab-label-primary);
        font-family: system-ui, sans-serif;
        padding: 2rem;
        display: flex;
        gap: 1rem;
        align-items: center;
      }
    </style>
  </head>
  <body>
    <h1 style="font-size:1.5rem;margin:0 1rem 0 0">Astro SSR</h1>
    <lab-button type="accent" kind="fill" data-testid="astro-accent-fill">Accent fill</lab-button>
    <lab-button type="danger" kind="border" data-testid="astro-danger-border">Danger</lab-button>
    <lab-button type="neutral" kind="ghost" data-testid="astro-neutral-ghost">Ghost</lab-button>
  </body>
</html>
