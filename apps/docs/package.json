{
  "name": "@labpics/ui-docs",
  "version": "0.0.0",
  "private": true,
  "description": "LabUI documentation site + Playwright smoke fixtures.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4321 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/liquid-glass/lg-math.unit.test.mjs tests/liquid-glass/lg-ci-wiring.e2e.test.mjs tests/liquid-glass/lg-cache.integration.test.mjs tests/liquid-glass/lg-pending-decode.regression.test.mjs tests/liquid-glass/lg-mutation.differential.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@labpics/colors": "workspace:*",
    "@labpics/ui-core": "workspace:*",
    "@labpics/ui-react": "workspace:*",
    "@labpics/ui-shadow": "workspace:*",
    "@labpics/ui-tokens": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@types/node": "22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "typescript": "5.7.3",
    "vite": "6.0.7"
  }
}
