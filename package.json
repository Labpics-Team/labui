{
  "name": "labui",
  "version": "0.0.0",
  "private": true,
  "description": "LabUI — high-level design system by Labpics",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "test:e2e": "pnpm --filter @labpics/ui-docs test:e2e",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "perf:size": "node scripts/perf-size.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@changesets/cli": "2.27.12",
    "tsup": "8.3.6",
    "typescript": "5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild"],
    "overrides": {
      "tmp@<0.2.6": ">=0.2.6",
      "esbuild@<0.25.0": ">=0.25.0",
      "js-yaml@<3.15.2": "3.15.2",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.2",
      "nanoid@<3.3.18": "3.3.18",
      "postcss@<8.5.18": "8.5.18",
      "devalue@<5.9.3": "5.9.3"
    },
    "patchedDependencies": {
      "braces@3.0.3": "patches/braces@3.0.3.patch",
      "http-cache-semantics@4.2.0": "patches/http-cache-semantics@4.2.0.patch"
    }
  }
}
