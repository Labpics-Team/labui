{
  "name": "labui",
  "version": "0.0.0",
  "private": true,
  "description": "Дизайн-система Labpics: компоненты, темы, семантические токены и материалы Solid, Glass, Acrylic.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=11.23.0"
  },
  "packageManager": "pnpm@11.28.12",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 --no-bail --if-present test",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "test:e2e": "pnpm --filter @labpics/ui-docs test:e2e",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "perf:size": "node scripts/perf-size.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@changesets/cli": "2.27.12",
    "js-yaml": "4.3.2",
    "tsup": "8.3.6",
    "typescript": "5.7.3"
  }
}
