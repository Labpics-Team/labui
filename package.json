{
  "name": "labui",
  "version": "0.0.0",
  "private": true,
  "description": "LabUI — high-level design system by Labpics",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 --no-bail --if-present test",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "test:e2e": "pnpm --filter @labpics/ui-docs test:e2e",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "perf:size": "node scripts/perf-size.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@changesets/cli": "2.27.12",
    "tsup": "8.3.6",
    "typescript": "5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild"],
    "overrides": {
      "tmp@<0.2.6": ">=0.2.6",
      "esbuild@<0.25.0": ">=0.25.0",
      "js-yaml@<3.15.2": "3.15.2",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.2",
      "nanoid@<3.3.18": "3.3.18",
      "postcss@<8.5.18": "8.5.18",
      "devalue@<5.9.3": "5.9.3",
      "seroval@<1.6.8": "1.6.8",
      "source-map-js@<1.2.2": "1.2.2",
      "tinypool@<2.1.2": "2.1.2",
      "undici@>=8 <8.12.2": "8.12.2",
      "astro@7.2.8>vite": "8.3.3",
      "zod@>=4 <4.6.6": "4.6.7"
    },
    "patchedDependencies": {
      "@zag-js/dom-query@1.41.2": "patches/@zag-js__dom-query@1.41.2.patch",
      "@zag-js/dismissable@1.41.2": "patches/@zag-js__dismissable@1.41.2.patch",
      "@zag-js/menu@1.41.2": "patches/@zag-js__menu@1.41.2.patch",
      "@zag-js/aria-hidden@1.41.2": "patches/@zag-js__aria-hidden@1.41.2.patch"
    }
  }
}
